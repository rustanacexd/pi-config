{
  "settings": {
    "namespaceProxyTools": false
  },
  "mcpServers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "directTools": false
    },
    "browse": {
      "env": {
        "OPENCODE_BROWSER_ALLOW_FILE_URLS": "1"
      },
      "directTools": false
    },
    "cua-driver": {
      "command": "~/.local/bin/cua-driver",
      "args": ["mcp"],
      "directTools": false
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@2.0.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--region",
        "us-east-1"
      ],
      "directTools": false,
      "approveTools": "destructive"
    }
  }
}
