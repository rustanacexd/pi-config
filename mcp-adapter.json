{
  "settings": {
    "namespaceProxyTools": false
  },
  "mcpServers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "directTools": false
    },
    "browse": {
      "env": {
        "OPENCODE_BROWSER_ALLOW_FILE_URLS": "1"
      },
      "directTools": false
    },
    "cua-driver": {
      "command": "~/.local/bin/cua-driver",
      "args": ["mcp"],
      "directTools": false
    }
  }
}
