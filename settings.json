{
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "compaction": {
    "modelOverrides": {
      "cliproxyapi/claude-opus-5-5": {
        "reserveTokens": 600000
      },
      "cliproxyapi/claude-fable-5-2": {
        "reserveTokens": 600000
      }
    }
  },
  "defaultModel": "claude-opus-5-5",
  "defaultProvider": "cliproxyapi",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "cliproxyapi/claude-opus-5-5",
    "cliproxyapi/claude-fable-5-2"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-tidy\",\"scope\":\"user\"}": "0.9.8",
    "{\"source\":\"npm:pi-rewind-hook\",\"scope\":\"user\"}": "1.8.9"
  },
  "hideThinkingBlock": true,
  "lastChangelogVersion": "1.5.2",
  "packages": [
    "npm:@plannotator/pi-extension",
    {
      "source": "npm:@router-for-me/pi-cliproxyapi-provider",
      "extensions": [
        "-extensions/tps.ts"
      ]
    },
    "npm:pi-btw",
    "npm:pi-web-access",
    "git:github.com/michael-denyer/pstack-claude",
    {
      "skills": [
        "agent-browser"
      ],
      "source": "npm:agent-browser"
    },
    {
      "skills": [
        "agent-desktop"
      ],
      "source": "git:github.com/vercel-labs/agent-desktop"
    },
    {
      "skills": [
        "clean-room",
        "ladder",
        "status"
      ],
      "source": "git:github.com/backnotprop/bro"
    },
    {
      "skills": [
        "gcloud",
        "finding-google-skills"
      ],
      "source": "git:github.com/google/skills"
    },
    {
      "skills": [
        "gh-stack"
      ],
      "source": "git:github.com/github/gh-stack"
    },
    {
      "skills": [
        "gh"
      ],
      "source": "git:github.com/cli/cli"
    },
    "npm:pi-mcp-adapter",
    "npm:pi-tidy",
    "npm:pi-rewind-hook",
    {
      "skills": [
        "design-artifact",
        "html",
        "html-diagram",
        "html-plan",
        "html-prototype",
        "html-wireframe",
        "one-pager"
      ],
      "source": "git:github.com/plannotator/effective-html"
    }
  ],
  "skills": [
    "!~/.agents/skills/**",
    "+~/.agents/skills/rex/SKILL.md",
    "+~/.agents/skills/rexume/SKILL.md"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "tidy": {
    "userMessageStyle": "off",
    "userMessagePaddingY": 2,
    "finalReplyStyle": "off",
    "messageBorderColors": { "assistant": "borderMuted" },
    "toolColors": {
      "bash": "bashMode",
      "read": "toolTitle",
      "edit": "borderMuted",
      "write": "borderMuted",
      "grep": "syntaxOperator",
      "find": "syntaxOperator",
      "ls": "syntaxOperator",
      "mcp": "customMessageLabel"
    }
  }
}
